# H2 Budget — environment contract
#
# Every variable the surviving code actually reads, and nothing else. Values
# here are PLACEHOLDERS; copy to `.env` (untracked) for local work. Production
# values live in the Render dashboard — see render.yaml, where secrets are
# declared `sync: false` so they are never committed.
#
# Nothing loads this file automatically (there is no dotenv dependency). Vite
# picks up `VITE_*` from `.env` for the web build; the server reads
# `process.env` as provided by the shell or by Render.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — the server will not work correctly without these.
# All are declared in render.yaml.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. On Render this is wired from the managed database.
DATABASE_URL=postgres://user:password@localhost:5432/h2budget

# Clerk (server-side auth verification).
CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>

# Plaid. PLAID_ENV is one of: sandbox | production.
PLAID_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx
PLAID_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PLAID_ENV=sandbox

# The single owner account. Gates owner-only routes and is the fallback
# recipient for operational alerts.
OWNER_EMAIL=owner@example.com

# Public origin of the deployment. Used to build invitation and Plaid
# reconnect links, and to derive the two Plaid URLs below.
APP_URL=https://h2budget.onrender.com
PLAID_WEBHOOK_URL=https://h2budget.onrender.com/api/plaid/webhook
PLAID_REDIRECT_URI=https://h2budget.onrender.com/plaid-oauth

# ─────────────────────────────────────────────────────────────────────────────
# BUILD-TIME — baked into the web bundle. Changing these requires a rebuild.
# ─────────────────────────────────────────────────────────────────────────────

# Clerk publishable key for the browser.
VITE_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>

# Vite `base`. Required whenever Vite SERVES (dev/preview); "/" in production.
BASE_PATH=/

# Vite dev/preview port. Required by vite.config.ts when serving.
PORT=5173

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — every one of these has a safe default in code. Listed so the full
# surface is discoverable; leave unset unless you are deliberately tuning.
# ─────────────────────────────────────────────────────────────────────────────

# NODE_ENV=production
# LOG_LEVEL=info                       # default: info

# Express rate limiter.
# RATE_LIMIT_WINDOW_MS=60000           # default: 60000
# RATE_LIMIT_MAX=600                   # default: 600

# Where the server looks for the built SPA. Defaults to the sibling
# artifacts/h2budget/dist/public, which is correct for the Render layout.
# WEB_DIST_DIR=

# Extra Plaid products requested as OPTIONAL (comma separated), e.g. liabilities.
# PLAID_OPTIONAL_PRODUCTS_CSV=liabilities

# Plaid sync debounce / grace tuning.
# PLAID_SYNC_DEBOUNCE_MS=
# PLAID_SYNC_GRACE_DEBOUNCE_MS=
# PLAID_SYNC_GRACE_WINDOW_MS=

# Plaid post-refresh polling.
# PLAID_REFRESH_POLL_ATTEMPTS=
# PLAID_REFRESH_POLL_DELAYS_MS=

# Malformed-token spike alert thresholds.
# MALFORMED_TOKEN_ALERT_THRESHOLD=
# MALFORMED_TOKEN_ALERT_GROWTH_ABSOLUTE=
# MALFORMED_TOKEN_ALERT_GROWTH_PERCENT=

# Operational alert recipient. Falls back to OWNER_EMAIL when unset.
# OPS_ALERT_EMAIL=

# Overrides the invitation landing URL. Falls back to APP_URL, then to the
# requesting host.
# INVITATION_REDIRECT_URL=

# SendGrid. Without these, alert and reminder emails are written to the logs
# instead of being sent — the app still works. Declared in render.yaml.
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# Clerk proxy origin, if fronting Clerk behind your own domain. Build-time.
# VITE_CLERK_PROXY_URL=

# ─────────────────────────────────────────────────────────────────────────────
# TEST / TOOLING ONLY — must NEVER be set in production.
# ─────────────────────────────────────────────────────────────────────────────

# Lets the test suite point at a database whose name does not look like a test
# DB. The guard in lib/db exists because tests once ran against real data.
# ALLOW_TEST_DB=1

# Skips Plaid webhook signature verification. Local development only.
# PLAID_WEBHOOK_VERIFICATION_DISABLED=true

# Overrides the per-deploy build id. Set by the deploy pre-build hook so the
# API and web bundles agree on a version; leave unset locally.
# APP_BUILD_ID=

# Playwright target. Defaults to http://localhost:5173.
# PLAYWRIGHT_BASE_URL=

# Set automatically by the runners, never by hand: CI, VITEST, VITEST_WORKER_ID.
